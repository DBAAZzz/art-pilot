{
  "name": "@art-pilot/desktop",
  "version": "1.0.1",
  "description": "",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "dist:dmg": "pnpm run dist:dmg:arm64",
    "dist:dmg:all": "pnpm run dist:dmg:arm64 && pnpm run dist:dmg:x64 && pnpm run dist:dmg:universal",
    "dist:dmg:arm64": "tsc && vite build && electron-builder --mac dmg --arm64",
    "dist:dmg:x64": "tsc && vite build && electron-builder --mac dmg --x64",
    "dist:dmg:universal": "tsc && vite build && electron-builder --mac dmg --universal",
    "rebuild:native": "electron-builder install-app-deps",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.artpilot.desktop",
    "productName": "Art Pilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/sign-macos-ad-hoc.cjs",
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debug": "^4.4.3",
    "electron-log": "^5.4.3",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.14.2",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@art-pilot/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/debug": "^4.1.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
